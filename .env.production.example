# ─────────────────────────────────────────────────────────────────────────────
#  Learnerium LMS — Production Environment Configuration (.env)
#  John Luka Media (JLM) Digital Ecosystem
#  Copy this file to .env and configure your production credentials.
#  Generate new APP_KEY with: php artisan key:generate
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Learnerium"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://learnerium.jlm.com.ng

LOG_CHANNEL=daily
LOG_LEVEL=info

# Database (Production MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gwylvxeo_learnerium
DB_USERNAME=gwylvxeo_learnerium
DB_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASS

# Cache & Sessions
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Production SMTP Mail
MAIL_MAILER=smtp
MAIL_HOST=mail.jlm.com.ng
MAIL_PORT=465
MAIL_USERNAME=learnerium@jlm.com.ng
MAIL_PASSWORD=CHANGE_ME_SMTP_PASS
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="learnerium@jlm.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

# Paystack Payment Gateway (Live Keys)
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY_HERE

# Gemini AI Features (Lesson plan generation & quiz assistant)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# JLM Unified Digital Ecosystem
ECOSYSTEM_API_SECRET=eco_sec_jlm_zavora_01a2c11beee84a1bb6e5ce40a29769f4
ZAVORA_URL=https://zavora.jlm.com.ng
JLM_CORPORATE_URL=https://jlm.com.ng
LMS_URL=https://lms.jlm.com.ng
